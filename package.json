{
  "name": "elegant-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "auth generate --config src/lib/auth.cli.ts --output src/db/auth-schema.ts",
    "db:seed": "tsx src/db/seed.ts",
    "admin:grant": "tsx src/db/grant-admin.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.15",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.24.0"
}
