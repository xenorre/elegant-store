# Copy to .env.local and fill in the values.

# Neon Postgres connection string (use the pooled connection string from the Neon console)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the Better Auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
